<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Risk Report — {{ scenario_name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #F8FAFC;
            --surface: #FFFFFF;
            --border: #E2E8F0;
            --text: #0F172A;
            --text-2: #475569;
            --text-3: #64748B;
            --accent: #2563EB;
            --accent-2: #4F46E5;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            max-width: 1100px;
            margin: 0 auto;
            padding: 40px 32px;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }
        .mono { font-family: 'JetBrains Mono', 'SF Mono', Consolas, monospace; }
        h1 {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text);
            margin-bottom: 4px;
        }
        .report-meta {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--text-3);
            padding-bottom: 16px;
            border-bottom: 2px solid var(--accent);
            margin-bottom: 32px;
        }
        h2 {
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--accent);
            margin-top: 40px;
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin: 20px 0 12px;
        }
        .kpi-card {
            background: var(--surface);
            padding: 20px;
            border: 1px solid var(--border);
            border-left: 3px solid var(--accent);
            border-radius: 6px;
        }
        .kpi-value {
            font-family: 'JetBrains Mono', monospace;
            font-size: 28px;
            font-weight: 600;
            color: var(--text);
            font-variant-numeric: tabular-nums;
            line-height: 1;
            margin-bottom: 6px;
        }
        .kpi-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-3);
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            margin: 16px 0 24px;
            font-size: 13px;
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
        }
        th {
            background: var(--accent);
            color: #FFFFFF;
            padding: 12px 14px;
            text-align: left;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        td {
            padding: 11px 14px;
            border-bottom: 1px solid var(--border);
            color: var(--text);
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #F1F5F9; }
        td.num {
            font-family: 'JetBrains Mono', monospace;
            font-variant-numeric: tabular-nums;
            text-align: right;
        }
        .narrative-card {
            background: var(--surface);
            padding: 20px 22px;
            margin: 12px 0;
            border: 1px solid var(--border);
            border-left: 3px solid var(--accent-2);
            border-radius: 6px;
            page-break-inside: avoid;
        }
        .narrative-title {
            font-weight: 600;
            font-size: 15px;
            color: var(--text);
            margin-bottom: 10px;
        }
        .narrative-field { margin: 6px 0; font-size: 13px; }
        .narrative-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-3);
            display: inline-block;
            min-width: 120px;
        }
        .footer {
            margin-top: 48px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: var(--text-3);
            text-align: center;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        @media print {
            body { padding: 24px; }
            .narrative-card, table { page-break-inside: avoid; }
        }
    </style>
</head>
<body>
    <div class="report-meta mono">
        Supply Chain Risk Engine · V2.1 · Executive Briefing
    </div>
    <h1>{{ scenario_name }}</h1>
    <div class="report-meta mono" style="margin-top: 4px; border: none; padding-bottom: 0;">
        Generated {{ "%.0f"|format(avg_risk * 100) if false else "" }} · Board-ready analysis
    </div>

    <h2>Executive KPIs</h2>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-value mono">{{ total_suppliers }}</div>
            <div class="kpi-label mono">Total Suppliers</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-value mono">{{ "%.3f"|format(avg_risk) }}</div>
            <div class="kpi-label mono">Avg Composite Risk</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-value mono">{{ high_risk_count }}</div>
            <div class="kpi-label mono">High-Risk (≥0.70)</div>
        </div>
    </div>

    <h2>Risk Distribution by Region</h2>
    {{ plotly_html|safe }}

    <h2>Top-10 Highest Risk Suppliers</h2>
    <table>
        <thead>
            <tr>
                <th>Supplier ID</th>
                <th>Name</th>
                <th style="text-align:right;">Risk Score</th>
                <th>Region</th>
            </tr>
        </thead>
        <tbody>
            {% for supplier in top_10 %}
            <tr>
                <td class="mono">{{ supplier.supplier_id }}</td>
                <td>{{ supplier.supplier_name }}</td>
                <td class="num">{{ "%.3f"|format(supplier.composite_risk) }}</td>
                <td>{{ supplier.region }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if top_narratives %}
    <h2>AI Risk Narratives — Top 5</h2>
    {% for supplier_id, narrative in top_narratives %}
    <div class="narrative-card">
        <div class="narrative-title">{{ narrative.supplier_name }} <span class="mono" style="color: var(--text-3); font-weight: 400; font-size: 12px;">// {{ supplier_id }}</span></div>
        <div class="narrative-field"><span class="narrative-label">Overall Risk</span> {{ narrative.overall_risk.value }}</div>
        <div class="narrative-field"><span class="narrative-label">Key Risks</span> {{ narrative.key_risks|join(', ') }}</div>
        <div class="narrative-field"><span class="narrative-label">Recommendation</span> {{ narrative.recommendation }}</div>
        <div class="narrative-field"><span class="narrative-label">Confidence</span> <span class="mono">{{ "%.2f"|format(narrative.confidence) }}</span></div>
    </div>
    {% endfor %}
    {% endif %}

    <div class="footer">
        Confidential · Generated by Supply Chain Risk Engine V2.1 · {{ scenario_name }}
    </div>
</body>
</html>
